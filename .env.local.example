DATABASE_URL=file:./data/dev.db
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
MIDHUB_VAULT_KEY=<base64 of 32 random bytes: openssl rand -base64 32>
# Optional (defaults shown)
# MIDHUB_ROOT=/opt/midhub
# MIDHUB_MAX_RUNNING=4
# MIDHUB_HELPER_SOCKET=/run/midhub/helper.sock
# Public base URL of the site as seen by browsers (no path), used for OIDC redirect URIs
# behind the reverse proxy, e.g. https://10.4.150.142
# PUBLIC_URL=https://10.4.150.142
