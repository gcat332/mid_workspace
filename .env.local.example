DATABASE_URL=file:./data/dev.db
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
MIDHUB_VAULT_KEY=<base64 of 32 random bytes: openssl rand -base64 32>
# Sign-in is through BSM AgentHub on this host: only AgentHub admins can use MidHub (no local login,
# ADMIN_EMAIL/ADMIN_PASSWORD are no longer used and are ignored if still present).
# AgentHub's base URL, asked GET /api/auth/me with the browser's AgentHub `session` cookie.
# Must be loopback: http://127.0.0.1:<port>, http://localhost:<port> or http://[::1]:<port>.
# AGENTHUB_URL=http://127.0.0.1:3000
# Account that must own AgentHub's TCP listener (checked in /proc/net/tcp{,6} before every lookup, so a local
# process squatting on the port while AgentHub is down never gets the cookie). Must exist in /etc/passwd.
# "none" disables the check: development only (e.g. AgentHub run by your own user), never in production.
# AGENTHUB_SERVICE_USER=bsmagenthub
# Optional (defaults shown)
# MIDHUB_ROOT=/opt/midhub
# MIDHUB_MAX_RUNNING=4
# MIDHUB_HELPER_SOCKET=/run/midhub/helper.sock
# Shared secret with BSM AgentHub for /midhub/api/agent/* (>= 32 chars: openssl rand -base64 48). Unset = AgentHub API off (404).
# MIDHUB_AGENT_SECRET=
