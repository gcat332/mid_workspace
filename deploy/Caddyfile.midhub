# MidHub reverse-proxy block.
# Paste INSIDE AgentHub's existing site block(s) in /etc/caddy/Caddyfile (the https://10.4.150.142 site, and the
# http://dev-agenthub.mfec.co.th site while it exists; browsers on https://dev-agenthub.mfec.co.th come through the
# F5 and AgentHub's /midhub rewrite instead, see deploy/README.md section 10), BEFORE any catch-all
# handle / reverse_proxy to :3000, so /midhub/* is matched first.
# Body limits (Caddy enforces them BEFORE the app authenticates, so an anonymous client cannot make
# the app buffer big bodies): only the file-upload endpoint may send up to 51 MiB (50 MiB file +
# multipart framing, = app proxyClientMaxBodySize "51mb"); every other /midhub request: 1 MiB.
# Units are MiB on purpose: Caddy reads "MB" as 10^6 bytes, which would clip a 50 MiB upload.
# AgentHub's site has a site-level `request_body { max_size 50MB }` that runs BEFORE `handle`, so by
# default (option b) the effective upload limit is slightly under 50 MB; option (a) in
# deploy/README.md lifts that for a full 50 MB file.
	@midhub path /midhub /midhub/*
	handle @midhub {
		# AgentHub's server-to-server API is loopback-only (AgentHub calls 127.0.0.1:3100 directly): never
		# expose it through Caddy. MUST stay the first lines inside this handle (a top-level `respond`
		# would be ordered AFTER the sibling handle and never run). Needs no body limit: it never reaches the app.
		@midhubAgent path /midhub/api/agent /midhub/api/agent/*
		respond @midhubAgent 404
		@midhubUpload path_regexp ^/midhub/api/mids/[^/]+/files$
		@midhubOther not path_regexp ^/midhub/api/mids/[^/]+/files$
		request_body @midhubUpload {
			max_size 51MiB
		}
		request_body @midhubOther {
			max_size 1MiB
		}
		reverse_proxy 127.0.0.1:3100 {
			header_up X-Forwarded-For {client_ip}
			# Do not buffer: live log tail is SSE.
			flush_interval -1
		}
	}
