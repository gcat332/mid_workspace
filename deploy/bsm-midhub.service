# MidHub web app (Next.js, basePath /midhub, port 3100).
# Template: install.sh replaces @APP_DIR@ with the repo checkout path.
[Unit]
Description=BSM MidHub (ServiceNow MID Server manager)
After=network.target bsm-midhub-helper.service
Wants=bsm-midhub-helper.service

[Service]
Type=simple
User=bsmmidhub
Group=bsmmidhub
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env.local
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3100
Environment=TZ=Asia/Bangkok
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=CHECKPOINT_DISABLE=1
# Apply pending migrations (idempotent). Repo-local prisma binary, never npx.
ExecStartPre=@APP_DIR@/node_modules/.bin/prisma migrate deploy
ExecStart=/usr/bin/node @APP_DIR@/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3100
Restart=on-failure
# SIGTERM on stop makes node exit 143; that is a clean stop, not a failure.
SuccessExitStatus=143
RestartSec=5
# Hardening. The app reads /proc/self/fd and /proc/meminfo and runs `systemctl show` /
# `list-units`, so ProtectProc/ProcSubset are deliberately NOT set.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Writable: only Next's build/cache dir and the MidHub data root (MIDs + SQLite DB in /opt/midhub/db).
# The rest of the checkout (incl. helper sources/build) stays read-only for the running app.
ReadWritePaths=@APP_DIR@/.next /opt/midhub
# 1G: one upload (<= 50 MiB, buffered whole; the app allows one at a time) + Next + Prisma headroom.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
