# EXAMPLE ONLY - rendered by helper/unit-template.ts renderUnit({name:"spike1", heapMb:1024,
# midRoot:"/opt/midhub/mids/spike1"}). The real unit is written by the helper to
# /etc/systemd/system/midhub-mid-<name>.service. Values confirmed by the Phase 0
# spike on 2026-11-18 (docs/spike-mid-linux.md).
[Unit]
Description=MidHub MID Server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=midsvc
Group=midhub
WorkingDirectory=/opt/midhub/mids/spike1/agent
# Files the MID creates stay group-writable (group midhub) so MidHub can edit them.
UMask=0002
# Confirmed in spike 2026-11-18 (docs/spike-mid-linux.md)
ExecStart=/opt/midhub/mids/spike1/agent/bin/mid.sh console
MemoryMax=1536M
# always (not on-failure): the MID restarts itself after the instance syncs properties (wrapper exits 0).
# An explicit systemctl stop is never auto-restarted. A crash loop still stops at StartLimitBurst.
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

